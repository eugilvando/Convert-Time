<Window x:Class="FileConverter.Views.ConvertWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Convert Time" Width="1140" Height="760" FontFamily="Segoe UI" FontSize="15" MinWidth="760" MinHeight="510" WindowStartupLocation="CenterScreen" Background="{DynamicResource Window_BackgroundBrush}" Foreground="{DynamicResource ReadyForegroundBrush}" AllowDrop="True" Drop="FilesDropped">
  <Window.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/ConversionPresetTemplates.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="28">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Tema" VerticalAlignment="Center" Margin="8"/>
        <ComboBox x:Name="Themes" Width="115" MinHeight="40" SelectionChanged="ThemeSelected"><ComboBoxItem>Sistema</ComboBoxItem><ComboBoxItem>Claro</ComboBoxItem><ComboBoxItem>Escuro</ComboBoxItem></ComboBox>
        <Button Content="Perfis" Click="OpenProfiles" MinHeight="40" Padding="14,6" Margin="8,0,0,0"/>
      </StackPanel>
      <StackPanel><TextBlock Text="Convert Time" Foreground="{DynamicResource MainBrush}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Converter ficheiros" FontWeight="SemiBold" FontSize="32"/></StackPanel>
    </DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
      <Button x:Name="ConvertButton" DockPanel.Dock="Right" Click="ConvertClick" Background="#FF7466" Foreground="#241716" MinWidth="190" MinHeight="46" Padding="20,8" FontWeight="SemiBold"/>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
    </DockPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource Button_BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Background="{DynamicResource Button_BackgroundBrush}">
        <DockPanel><TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="20" Text="Ficheiros de origem" Margin="0,0,0,12"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"><Button Click="AddFiles" MinHeight="40" Padding="14,6">Adicionar ficheiros…</Button><Button Click="RemoveFiles" MinHeight="40" Padding="14,6" Margin="8,0,0,0">Remover</Button></StackPanel>
          <ListBox x:Name="FileList" SelectionMode="Extended" HorizontalContentAlignment="Stretch" Background="{DynamicResource Window_BackgroundBrush}" Foreground="{DynamicResource ReadyForegroundBrush}" BorderThickness="0" ToolTip="Arraste ficheiros para aqui">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="10,8"/></Style></ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Button_BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Background="{DynamicResource Button_BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock FontWeight="SemiBold" FontSize="20" Text="Opções de conversão"/>
          <TextBlock Text="Categoria" Margin="0,12,0,4"/><ComboBox Name="Categories" SelectionChanged="CategoryChanged"/>
          <TextBlock Text="Perfil de saída" Margin="0,12,0,4"/><ComboBox Name="Presets" DisplayMemberPath="FullName" SelectionChanged="PresetChanged"/>
          <ContentControl x:Name="Options" Margin="0,12,0,4" Style="{StaticResource OutputTypeSelectorStyle}"/>
          <TextBlock Text="Destino" Margin="0,12,0,4"/><DockPanel><Button DockPanel.Dock="Right" Click="BrowseFolder" Padding="8,3">Escolher…</Button><Button DockPanel.Dock="Right" Click="ResetFolder" ToolTip="Usar o destino do perfil">↺</Button><TextBlock x:Name="Destination" Text="Definido pelo perfil" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>