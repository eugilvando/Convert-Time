<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="TransparentColor">#00FFFFFF</Color>

    <Color x:Key="MainLighterColor">#FFD9D4</Color>
    <Color x:Key="MainLightColor">#F8A79F</Color>
    <Color x:Key="MainColor">#AF4038</Color>
    <Color x:Key="MainDarkColor">#83362F</Color>
    <Color x:Key="MainDarkerColor">#6F2721</Color>

    <Color x:Key="LighterForegroundColor">#62636A</Color>
    <Color x:Key="LightForegroundColor">#4D4D4D</Color>
    <Color x:Key="DarkForegroundColor">#202020</Color>
    <Color x:Key="AccentForegroundColor">#BC0D01</Color>
    <Color x:Key="PendingForegroundColor">#E9AB01</Color>
    <Color x:Key="SuccessForegroundColor">#0EAF80</Color>
    <Color x:Key="ErrorForegroundColor">#E91101</Color>

    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="DarkBackgroundColor">#E0E0E0</Color>
    <Color x:Key="AccentBackgroundColor">#FFA88C</Color>
    <Color x:Key="PendingBackgroundColor">#FFF3D1</Color>
    <Color x:Key="SuccessBackgroundColor">#BFFAE8</Color>
    <Color x:Key="ErrorBackgroundColor">#FFD4D1</Color>

    <Color x:Key="Window_BackgroundColor">#FCF8F6</Color>
    <Color x:Key="Control_BorderColor">#D0D0D0</Color>
    <Color x:Key="Button_BackgroundColor">#FDFDFD</Color>
    <Color x:Key="Button_MouseOver_BackgroundColor">#F5E9E7</Color>
    <Color x:Key="TileButton_MouseOver_BackgroundColor">#F3EFED</Color>
    <Color x:Key="TileButton_MouseOver_BorderColor">#D3D0CE</Color>

    <!-- Custom styles colors -->
    <SolidColorBrush x:Key="Button_BackgroundBrush" Color="{DynamicResource Button_BackgroundColor}" />
    <SolidColorBrush x:Key="Button_BorderBrush" Color="{DynamicResource Control_BorderColor}" />
    <SolidColorBrush x:Key="Button_IsMouseOver_BackgroundBrush" Color="{DynamicResource Button_MouseOver_BackgroundColor}" />
    <SolidColorBrush x:Key="Button_IsMouseOver_BorderBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="Button_IsPressed_BackgroundBrush" Color="{DynamicResource MainLighterColor}" />
    <SolidColorBrush x:Key="Button_IsPressed_BorderBrush" Color="{DynamicResource MainDarkColor}" />

    <SolidColorBrush x:Key="Hyperlink_ForegroundBrush" Color="{DynamicResource MainColor}" />

    <SolidColorBrush x:Key="TabControl_BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="TabControl_BorderBrush" Color="{DynamicResource Control_BorderColor}" />
    <SolidColorBrush x:Key="TabItem_BackgroundBrush" Color="{DynamicResource Control_BorderColor}" />
    <SolidColorBrush x:Key="TabItem_BorderBrush" Color="{DynamicResource TransparentColor}" />
    <SolidColorBrush x:Key="TabItem_IsSelected_BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="TabItem_IsSelected_BorderBrush" Color="{DynamicResource Control_BorderColor}" />

    <SolidColorBrush x:Key="TextBox_BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    
    <SolidColorBrush x:Key="TileButton_BackgroundBrush" Color="{DynamicResource TransparentColor}" />
    <SolidColorBrush x:Key="TileButton_BorderBrush" Color="{DynamicResource TransparentColor}" />
    <SolidColorBrush x:Key="TileButton_IsMouseOver_BackgroundBrush" Color="{DynamicResource TileButton_MouseOver_BackgroundColor}" />
    <SolidColorBrush x:Key="TileButton_IsMouseOver_BorderBrush" Color="{DynamicResource TileButton_MouseOver_BorderColor}" />
    <SolidColorBrush x:Key="TileButton_IsPressed_BackgroundBrush" Color="{DynamicResource MainLighterColor}" />
    <SolidColorBrush x:Key="TileButton_IsPressed_BorderBrush" Color="{DynamicResource TransparentColor}" />

    <SolidColorBrush x:Key="TreeView_BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="TreeView_BorderBrush" Color="{DynamicResource Control_BorderColor}" />

    <SolidColorBrush x:Key="Window_BackgroundBrush" Color="{DynamicResource Window_BackgroundColor}" />

    <!-- Markdown -->
    <SolidColorBrush x:Key="Markdown_ForegroundBrush" Color="{DynamicResource LighterForegroundColor}" />
    <SolidColorBrush x:Key="Markdown_BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="Markdown_Heading1ForegroundBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="Markdown_Heading2ForegroundBrush" Color="{DynamicResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="Markdown_Heading3ForegroundBrush" Color="{DynamicResource AccentForegroundColor}" />

    <!-- Colors used by ConversionStateToBrush -->
    <SolidColorBrush x:Key="UnknownForegroundBrush" Color="{DynamicResource LighterForegroundColor}" />
    <SolidColorBrush x:Key="ReadyForegroundBrush" Color="{DynamicResource DarkForegroundColor}" />
    <SolidColorBrush x:Key="InProgressForegroundBrush" Color="{DynamicResource PendingForegroundColor}" />
    <SolidColorBrush x:Key="DoneForegroundBrush" Color="{DynamicResource SuccessForegroundColor}" />
    <SolidColorBrush x:Key="FailedForegroundBrush" Color="{DynamicResource ErrorForegroundColor}" />

    <SolidColorBrush x:Key="UnknownBackgroundBrush" Color="{DynamicResource DarkBackgroundColor}" />
    <SolidColorBrush x:Key="ReadyBackgroundBrush" Color="{DynamicResource DarkBackgroundColor}" />
    <SolidColorBrush x:Key="InProgressBackgroundBrush" Color="{DynamicResource PendingBackgroundColor}" />
    <SolidColorBrush x:Key="DoneBackgroundBrush" Color="{DynamicResource SuccessBackgroundColor}" />
    <SolidColorBrush x:Key="FailedBackgroundBrush" Color="{DynamicResource ErrorBackgroundColor}" />
    
    <!-- Misc -->
    <SolidColorBrush x:Key="MainLighterBrush" Color="{DynamicResource MainLighterColor}" />
    <SolidColorBrush x:Key="MainLightBrush" Color="{DynamicResource MainLightColor}" />
    <SolidColorBrush x:Key="MainBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="MainDarkBrush" Color="{DynamicResource MainDarkColor}" />
    <SolidColorBrush x:Key="MainDarkerBrush" Color="{DynamicResource MainDarkerColor}" />
    <SolidColorBrush x:Key="LighterForegroundBrush" Color="{DynamicResource LighterForegroundColor}" />
    <SolidColorBrush x:Key="LightForegroundBrush" Color="{DynamicResource LightForegroundColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{DynamicResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="{DynamicResource ErrorForegroundColor}" />
    
</ResourceDictionary>
    